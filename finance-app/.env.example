# Copy to .env for docker compose, or to .env.local for `npm run dev`.
# Both are gitignored. Never commit a filled-in copy.

# Connection string used by the Next app, the worker, and both scripts.
# For docker compose the host is the postgres service name:
DATABASE_URL=postgresql://finance:CHANGEME@postgres:5432/finance

# For local development against a Postgres on your machine:
# DATABASE_URL=postgresql://finance:CHANGEME@localhost:5432/finance

# --- docker compose only -----------------------------------------------
# Must match the credentials in DATABASE_URL above.
POSTGRES_USER=finance
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=finance

# Host port the dashboard is served on.
APP_PORT=3000
