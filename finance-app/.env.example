# Copy to .env for docker compose, or to .env.local for `npm run dev`.
# Both are gitignored. Never commit a filled-in copy.

# Connection string used by the Next app, the worker, and both scripts.
# For docker compose the host is the postgres service name:
DATABASE_URL=postgresql://finance:CHANGEME@postgres:5432/finance

# For local development against a Postgres on your machine:
# DATABASE_URL=postgresql://finance:CHANGEME@localhost:5432/finance

# --- docker compose only -----------------------------------------------
# Must match the credentials in DATABASE_URL above.
POSTGRES_USER=finance
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=finance

# Host port the dashboard is served on.
APP_PORT=3000

# --- authentication: Google sign-in --------------------------------------
# Set all of these with:
#   npm run auth:setup                 -> writes .env.local (local development)
#   npm run auth:setup -- --env .env   -> writes this file (docker compose)
#
# The script edits the file directly. Do NOT redirect it (`>> .env`): npm's
# script banner lands in the file, and PowerShell writes UTF-16, which dotenv
# cannot read. Both failures are silent until sign-in stops working.
#
# Next gives .env.local priority over .env, so a value there wins for
# `npm run dev`. Compose reads .env only.
#
# NOTE: Next runs dotenv-expand over these files, so a literal `$` in ANY value
# here is read as a variable reference and silently eaten. That applies to
# POSTGRES_PASSWORD and DATABASE_URL too — escape it as \$ if a value contains one.
#
# Auth is fail-closed: with AUTH_SECRET or AUTH_ALLOWED_EMAILS unset, every
# request is refused rather than served without a login.

# Signs session cookies. 32 random bytes, base64. Rotating it signs out everyone.
AUTH_SECRET=

# From an OAuth 2.0 Client ID of type "Web application" in the Google Cloud
# console (APIs & Services -> Credentials). Its authorized redirect URI must be
# exactly ${AUTH_URL}/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The origin people use to reach the app. Google redirects back here, and only
# accepts https (or http://localhost) with a real domain name — not a bare IP
# address. On a tailnet, `tailscale serve` gives you https://<machine>.<tailnet>.ts.net.
#   AUTH_URL=http://localhost:3000            (local development)
#   AUTH_URL=https://nas.example-tailnet.ts.net
AUTH_URL=

# Who may sign in: Google account emails, comma-separated. Each gets their own
# separate tracker the first time they sign in. Removing someone here and
# restarting signs them out immediately.
#   AUTH_ALLOWED_EMAILS=you@gmail.com,partner@gmail.com
# `*` admits any Google account at all. There is no default, on purpose.
AUTH_ALLOWED_EMAILS=

# Session cookies are Secure when AUTH_URL is https, and not otherwise.
# Override only if that guess is wrong for your proxy setup.
# AUTH_COOKIE_SECURE=true
