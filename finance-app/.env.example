# Copy to .env for docker compose, or to .env.local for `npm run dev`.
# Both are gitignored. Never commit a filled-in copy.

# Connection string used by the Next app, the worker, and both scripts.
# For docker compose the host is the postgres service name:
DATABASE_URL=postgresql://finance:CHANGEME@postgres:5432/finance

# For local development against a Postgres on your machine:
# DATABASE_URL=postgresql://finance:CHANGEME@localhost:5432/finance

# --- docker compose only -----------------------------------------------
# Must match the credentials in DATABASE_URL above.
POSTGRES_USER=finance
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=finance

# Host port the dashboard is served on.
APP_PORT=3000

# --- authentication ------------------------------------------------------
# Generate both of these with:
#   npm run auth:setup                 -> writes .env.local (local development)
#   npm run auth:setup -- --env .env   -> writes this file (docker compose)
#
# The script edits the file directly. Do NOT redirect it (`>> .env`): npm's
# script banner lands in the file, and PowerShell writes UTF-16, which dotenv
# cannot read. Both failures are silent until login stops working.
#
# Next gives .env.local priority over .env, so a value there wins for
# `npm run dev`. Compose reads .env only.
#
# Passwords may contain spaces, including leading and trailing ones, and they
# are significant.
#
# NOTE: Next runs dotenv-expand over these files, so a literal `$` in ANY value
# here is read as a variable reference and silently eaten. That applies to
# POSTGRES_PASSWORD and DATABASE_URL too — escape it as \$ if your password
# contains one. AUTH_PASSWORD_HASH no longer uses `$` for exactly this reason.
#
# Auth is fail-closed: with these unset, every request is refused rather than
# served without a login.
AUTH_SECRET=
AUTH_PASSWORD_HASH=

# Rotating AUTH_SECRET signs out every existing session. There is no per-session
# revocation — the session is a signed cookie, not a database row.

# Set only behind a TLS reverse proxy. A Secure cookie is never sent over plain
# HTTP, so enabling this on a LAN makes login silently fail.
# AUTH_COOKIE_SECURE=true

# Local development escape hatch: runs with no login at all. Never set this on
# anything reachable from outside your machine. Set both — the second is what
# hides the Sign out button, and NEXT_PUBLIC_* is inlined at build time.
# AUTH_DISABLED=true
# NEXT_PUBLIC_AUTH_DISABLED=true
